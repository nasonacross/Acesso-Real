# ==========================================
# Configurações de Ambiente — AcessoReal
# ==========================================

# Porta local do servidor
PORT=3001

# Google Gemini API (para análise de imagens por IA Multimodal)
GEMINI_API_KEY=sua_chave_gemini_api_aqui

# Supabase (Banco de Dados PostgreSQL na nuvem)
SUPABASE_URL=https://sua-url-supabase.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-supabase
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-supabase

# Frontend Vite Supabase
VITE_SUPABASE_URL=https://sua-url-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-supabase
