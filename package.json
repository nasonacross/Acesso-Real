{
  "name": "acessoreal-platform",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "AcessoReal — Plataforma Inteligente de Acessibilidade Universal, Rotas em Tupã (FADAP) e Compatibilidade Pessoal",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build"
  },
  "keywords": [
    "acessibilidade",
    "tupa",
    "fadap",
    "pwa",
    "inclusao",
    "nbr9050",
    "pcd",
    "neurodiversidade",
    "supabase",
    "vercel",
    "visao-computacional"
  ],
